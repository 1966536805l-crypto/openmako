{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1966536805l-crypto/openmako/blob/main/docs/evidence_court_record.schema.json",
  "title": "Evidence Court Audit Record",
  "description": "Supplied audit record accepted by `openmako evidence-court audit <run.json>`. This is not a native Claude Code, Codex, Cursor, or SWE-bench transcript schema.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "claimed_task": {
      "type": "string",
      "description": "Task or claim being audited."
    },
    "source_format": {
      "type": "string",
      "description": "Optional repository-defined supplied-record format label, such as codex-transcript/v0.1. This is not a native product export claim."
    },
    "allowed_files": {
      "$ref": "#/$defs/fileList",
      "description": "Optional edit allowlist. Any other edited file is reported as a scope violation."
    },
    "files_read": {
      "$ref": "#/$defs/fileList",
      "description": "Files the record says the agent inspected."
    },
    "files_edited": {
      "$ref": "#/$defs/fileList",
      "description": "Files the record says the agent modified."
    },
    "diff_hunks": {
      "type": "array",
      "description": "Optional supplied diff-content evidence. Transcript-based successful source repair claims without this evidence are routed to suspicious review.",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              }
            }
          }
        ]
      }
    },
    "test_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "exit_code": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "run_metrics": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional telemetry supplied by the run record. Evidence Court preserves it in machine JSON but does not treat it as proof that validation ran.",
      "properties": {
        "duration_seconds": {
          "type": "number"
        },
        "command_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "actual_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "missing_telemetry": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifact_provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional artifact identity metadata supplied by the record. Evidence Court preserves it in machine JSON but does not treat it as proof that native benchmark ingestion is supported or that benchmark scores are valid.",
      "properties": {
        "eval_rule_version": {
          "type": "string"
        },
        "eval_rule_commit": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        },
        "runner_commit": {
          "type": "string"
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifact_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "missing_provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ledger_identity": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional supplied ledger identity metadata, including recognized fields and extra supplied run or trace identity fields. Evidence Court preserves it in machine JSON but does not treat it as proof of native transcript ingestion, live control, or patch application outside the supplied record.",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "tool_invocation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agent_risk_ledger": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional supplied agent-risk metadata for autonomy and self-improvement claims. Evidence Court preserves it in machine JSON and routes unsupported live-control or self-improvement claims to suspicious review; it is not proof of live control or learning outside the supplied record.",
      "properties": {
        "live_control": {
          "type": "boolean"
        },
        "self_improved": {
          "type": "boolean"
        },
        "permission_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_call_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill_change_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "final_claim": {
      "type": "string",
      "description": "Agent's final success or completion claim."
    },
    "source_agent": {
      "type": "string",
      "description": "Optional source agent label supplied by the record."
    }
  },
  "$defs": {
    "fileList": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
